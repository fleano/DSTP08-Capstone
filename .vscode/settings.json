{
    // Use Prettier as the default formatter for JavaScript files.
    "[javascript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },

    // Use Prettier as the default formatter for JSON files.
    "[json]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },

    // Use Prettier as the default formatter for JSON with comments.
    "[jsonc]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },

    // Automatically format files when saving.
    "editor.formatOnSave": true,

    // Automatically format pasted code.
    "editor.formatOnPaste": true,

    // Remove whitespace at the end of lines when saving.
    "files.trimTrailingWhitespace": true,

    // Ensure every file ends with a newline character.
    "files.insertFinalNewline": true,

    // Display a vertical guide line at column 100.
    // Helps keep lines from becoming too long.
    "editor.rulers": [100]
}
